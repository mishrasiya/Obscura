{
  "name": "obscura",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first middleware platform for sanitizing prompts sent to LLM providers (OpenAI, Anthropic, Gemini)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3"
  }
}
