# ── Obscura demo-ui environment ──────────────────────────────────────────────
# Copy to .env on the server and fill in. Never commit the real .env.

# REQUIRED: your Anthropic API key (used for the actual LLM calls).
ANTHROPIC_API_KEY=sk-ant-...

# STRONGLY RECOMMENDED: secret used to sign auth (JWT) cookies. Without it the
# server falls back to a public hardcoded dev secret — anyone could forge logins.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Only needed when serving HTTPS via the bundled Caddy service
# (docker compose --profile tls up -d). Must be a DNS name pointed at this host.
DOMAIN=
